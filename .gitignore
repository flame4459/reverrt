# macOS
.DS_Store
.AppleDouble

# Xcode build products and per-user state
.build/
.build*/
build/
DerivedData/
*.xcresult
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Per-user Xcode state (shared schemes live in xcshareddata and are committed)
